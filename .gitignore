# Only what the site needs goes to GitHub. Everything else stays on this
# computer only (it is still in the folder, git just ignores it).
# Allow-list: ignore everything in the root, then let the site files back in.
# A new page or site folder must be added here before git will see it.
/*
!/.gitignore
!/index.html
!/recipes.html
!/recipe.html
!/kitchen.html
!/cook.html
!/history.html
!/css/
!/js/
!/fonts/
!/icons/
!/img/

# Full-size original photos - the site only uses the small copies in img/350/
/img/*.jpg
/img/*.jpeg
/img/*.png

# Ready-meal photos: originals and the full-size WebP stay local; the site uses webp350 and webp500
/img/ready/*.jpg
/img/ready/*.jpeg
/img/ready/*.png
/img/ready/webp1000/
# Photos of recipes taken off the list (kept locally, not published)
/img/ready/nope/

# Editor and system files
Thumbs.db
desktop.ini
.DS_Store

# Credentials must never become website assets or enter version control.
.env
.env.*
*.pem
*.key
