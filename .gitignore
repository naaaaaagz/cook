# Only what the site needs goes to GitHub. Everything listed here stays on
# this computer only (it is still in the folder, git just ignores it).

# Full-size original photos - the site only uses the small copies in img/350/
/img/*.jpg
/img/*.jpeg
/img/*.png

# Ready-meal photos: originals and the full-size WebP stay local; the site uses webp350 and webp500
/img/ready/*.jpg
/img/ready/*.jpeg
/img/ready/*.png
/img/ready/webp1000/
# Photos of recipes taken off the list (kept locally, not published)
/img/ready/nope/

# Mockups and reference images made while designing
/mockup-cooking-guide.png
/flowchart-carbonara.png
/kitchen-icons.jpg

# Working data and notes
/*.csv
/food stock photos.txt
/Recipes - text - review.txt

# Image conversion helper (run locally, not part of the site)
/tools/
/convert_images.bat
/convert_ready_images.bat

# Claude, editor and temp files (incl. Claude/Codex handoff notes)
/.handoff/
/.claude/
/.codex/
/.tmp/
/.vscode/
Thumbs.db
desktop.ini
.DS_Store

# Credentials must never become website assets or enter version control.
.env
.env.*
!.env.example
*.pem
*.key

# Ads folder: local only, everything in it now and later
/ads/
